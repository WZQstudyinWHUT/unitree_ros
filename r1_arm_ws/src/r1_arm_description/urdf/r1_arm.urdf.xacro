<?xml version="1.0"?>
<!--
  R1 机械臂 ROS2 描述（fork 自宇树官方 upstream/R1_Robotic_Arm.urdf）。

  原则：
  - 官方 joint origin/axis/limit 为权威几何，逐值镜像，不得"规整化"
    （J5 的 -1°、J6 的 -0.938°、J7 的 Ry(pi) 翻转都是真实运动链的一部分）。
  - 官方 URDF 的 velocity 限值（18.7/33.4/37.7 rad/s）疑似电机侧参数，
    关节级安全限值在 config/joint_limits.yaml 中另行覆盖。
  - tool0 为末端法兰坐标系：Z 轴 = J7 旋转轴指向法兰外侧（即 Link7 的 -Z），
    零位时近似与 base_link 对齐（残余 ~1.33° 来自官方链条几何，属真实值，
    不可通过 frame 定义消除）。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="R1_Robotic_Arm">

  <!-- mesh 路径前缀：ROS2 默认 package://；MuJoCo 等外部工具用
       xacro ... mesh_prefix:=/abs/path/to/meshes 覆盖 -->
  <xacro:arg name="mesh_prefix" default="package://r1_arm_description/meshes"/>

  <!-- 法兰面相对 Link7 原点的偏移，待实测标定后修改 -->
  <xacro:property name="tool0_xyz" value="0 0 0"/>

  <material name="silvery">
    <color rgba="0.79216 0.81961 0.93333 1"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.69804 0.69804 0.69804 1"/>
  </material>

  <xacro:macro name="r1_link"
               params="name mass com ixx ixy ixz iyy iyz izz material_name">
    <link name="${name}">
      <inertial>
        <origin xyz="${com}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
                 iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(arg mesh_prefix)/visual/${name}.STL"/>
        </geometry>
        <material name="${material_name}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="$(arg mesh_prefix)/collision/${name}.STL"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="r1_joint"
               params="name parent child xyz rpy axis lower upper effort velocity">
    <joint name="${name}" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
    </joint>
  </xacro:macro>

  <!-- ===================== links（官方 inertial 参数） ===================== -->
  <xacro:r1_link name="base_link" mass="1.7759"
    com="-0.00010643 0.0010041 0.023203"
    ixx="0.0014112" ixy="1.7968E-06" ixz="1.2255E-06"
    iyy="0.001783"  iyz="-8.2296E-06" izz="0.0025584"
    material_name="silvery"/>

  <xacro:r1_link name="Link1" mass="0.89452"
    com="2.156E-08 -9.6233E-09 0.045314"
    ixx="0.00082526" ixy="1.1484E-09" ixz="-7.1331E-10"
    iyy="0.0006531"  iyz="5.9698E-10" izz="0.00059909"
    material_name="dark_gray"/>

  <xacro:r1_link name="Link2" mass="0.74773"
    com="0.0017013 0.063321 -0.0042531"
    ixx="0.001137" ixy="9.3E-05" ixz="-6E-06"
    iyy="0.000672" iyz="3.2E-05" izz="0.001314"
    material_name="dark_gray"/>

  <xacro:r1_link name="Link3" mass="0.71845"
    com="-0.0062069 0.075751 0.012556"
    ixx="0.000746" ixy="2.9E-05" ixz="1.3E-05"
    iyy="0.000558" iyz="-0.000086" izz="0.000728"
    material_name="dark_gray"/>

  <xacro:r1_link name="Link4" mass="0.85572"
    com="-0.020915 -0.070455 0.060056"
    ixx="0.001009" ixy="-8.4E-05" ixz="6.3E-05"
    iyy="0.000707" iyz="0.000139" izz="0.00093"
    material_name="dark_gray"/>

  <xacro:r1_link name="Link5" mass="0.59294"
    com="0.00042498 -0.043121 0.00020709"
    ixx="0.000506" ixy="2E-06" ixz="-1E-06"
    iyy="0.000349" iyz="-1E-06" izz="0.000501"
    material_name="dark_gray"/>

  <xacro:r1_link name="Link6" mass="0.391"
    com="-1.3033E-07 -0.0098039 8.3267E-17"
    ixx="0.00014242" ixy="0" ixz="0"
    iyy="0.00014737" iyz="0" izz="0.00015188"
    material_name="dark_gray"/>

  <xacro:r1_link name="Link7" mass="0.1048"
    com="-3.7143E-07 -0.018577 0.00595"
    ixx="0.000105" ixy="0" ixz="0"
    iyy="7.3E-05" iyz="0" izz="6.7E-05"
    material_name="dark_gray"/>

  <!-- ===================== joints（官方 origin/axis/limit，勿改） ===================== -->
  <xacro:r1_joint name="J1" parent="base_link" child="Link1"
    xyz="0 0 0.069" rpy="0 0 0" axis="0 0 -1"
    lower="-2.723" upper="2.723" effort="60" velocity="18.7"/>

  <xacro:r1_joint name="J2" parent="Link1" child="Link2"
    xyz="0 0 0.0469" rpy="0 0 0" axis="1 0 0"
    lower="0" upper="3.1416" effort="60" velocity="18.7"/>

  <xacro:r1_joint name="J3" parent="Link2" child="Link3"
    xyz="0 0.1085 -0.0047926" rpy="0 0 0" axis="0 1 0"
    lower="-0.349" upper="3.491" effort="33" velocity="33.4"/>

  <xacro:r1_joint name="J4" parent="Link3" child="Link4"
    xyz="0.025 0.082408 0.016191" rpy="0 0 0" axis="1 0 0"
    lower="-3.1415" upper="0" effort="33" velocity="33.4"/>

  <xacro:r1_joint name="J5" parent="Link4" child="Link5"
    xyz="-0.022314 -0.10786 0.062877" rpy="-0.017453 0 0" axis="0 1 0"
    lower="-2.269" upper="2.269" effort="33" velocity="33.4"/>

  <xacro:r1_joint name="J6" parent="Link5" child="Link6"
    xyz="-1.1462E-05 -0.1072 0.00069991" rpy="0 -0.016375 0" axis="-1 0 0"
    lower="-0.524" upper="0.524" effort="10" velocity="37.7"/>

  <xacro:r1_joint name="J7" parent="Link6" child="Link7"
    xyz="0 -0.01 0" rpy="-3.1416 0 -3.1416" axis="0 0 -1"
    lower="-1.571" upper="1.571" effort="10" velocity="37.7"/>

  <!-- ===================== 末端法兰工具坐标系 ===================== -->
  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="Link7"/>
    <child link="tool0"/>
    <!-- Ry(pi)：tool0 的 Z 轴 = Link7 的 -Z（J7 法兰旋转轴指向外侧），
         零位时 tool0 近似与 base_link 对齐（残余 ~1.33° 为真实链条几何） -->
    <origin xyz="${tool0_xyz}" rpy="${pi} 0 ${pi}"/>
  </joint>

</robot>
